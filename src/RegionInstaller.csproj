<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
	    <Version>1.0.0</Version>
        <DebugType>embedded</DebugType>
        <Description>Auto-manages and injects custom modded regions into Among Us while filtering out official servers.</Description>
        <Authors>Nb1X</Authors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Default|AnyCPU'">
        <AssemblyName>RegionInstaller</AssemblyName>
        <DefineConstants>TRACE</DefineConstants>
        <OutputPath>bin\Default\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Lite|AnyCPU'">
        <AssemblyName>RegionInstaller</AssemblyName>
	<TargetName>RegionInstaller</TargetName>
        <DefineConstants>TRACE;LITE</DefineConstants>
        <OutputPath>bin\Lite\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735"   />

        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />

        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" />
    </ItemGroup>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
    </Target>

    <Target Name="RenameLiteDll" AfterTargets="Build" Condition="'$(Configuration)' == 'Lite'">
        <Move SourceFiles="$(OutDir)$(TargetFileName)" DestinationFiles="$(OutDir)RegionInstallerLite.dll" />
    </Target>

</Project>